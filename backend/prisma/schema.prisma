// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum PaymentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  TENANT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
  PENDING
  OVERDUE
  CANCELLED
}

enum MaintenanceStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvitationStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
  REJECTED
}

model User {
  id          Int      @id @default(autoincrement())
  fullName    String
  email       String   @unique
  password    String?
  clerkUserId String?  @unique
  role        UserRole @default(TENANT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant                     Tenant?
  assignedRepairs            MaintenanceRequest[]         @relation("AssignedStaff")
  maintenanceStatusChanges   MaintenanceStatusHistory[]   @relation("MaintenanceStatusActor")
  verifiedPaymentSubmissions PaymentSubmission[]          @relation("PaymentSubmissionVerifier")
  paymentVerificationActions PaymentVerificationHistory[] @relation("PaymentVerificationActor")
  passwordResetTokens        PasswordResetToken[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model Room {
  id          Int        @id @default(autoincrement())
  roomNumber  String     @unique
  building    String     @default("Dormitory")
  floor       Int        @default(1)
  roomType    String     @default("Shared")
  capacity    Int
  monthlyRent Decimal    @db.Decimal(10, 2)
  description String?
  status      RoomStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignments RoomAssignment[]
  maintenance MaintenanceRequest[]
  invitations RoomInvitation[]
}

model Tenant {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  contactNumber    String?
  address          String?
  emergencyContact String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user               User                 @relation(fields: [userId], references: [id])
  assignments        RoomAssignment[]
  payments           Payment[]
  paymentSubmissions PaymentSubmission[]
  maintenance        MaintenanceRequest[]
  invitations        RoomInvitation[]
}

model RoomAssignment {
  id          Int              @id @default(autoincrement())
  tenantId    Int
  roomId      Int
  moveInDate  DateTime
  moveOutDate DateTime?
  status      AssignmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  room   Room   @relation(fields: [roomId], references: [id])

  @@index([tenantId])
  @@index([roomId])
}

model Payment {
  id              Int           @id @default(autoincrement())
  tenantId        Int
  amount          Decimal       @db.Decimal(10, 2)
  paymentDate     DateTime?
  paymentMethod   String
  paymentStatus   PaymentStatus @default(UNPAID)
  dueDate         DateTime?
  description     String?
  referenceNumber String?       @unique
  amountPaid      Decimal       @default(0) @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  submissions PaymentSubmission[]

  @@index([tenantId])
}

model PaymentSubmission {
  id               Int                     @id @default(autoincrement())
  paymentId        Int
  tenantId         Int
  amount           Decimal                 @db.Decimal(10, 2)
  paymentMethod    String
  paymentDate      DateTime
  referenceNumber  String                  @unique
  proofFileName    String
  proofMimeType    String
  proofSize        Int
  proofData        Bytes
  status           PaymentSubmissionStatus @default(PENDING)
  rejectionRemarks String?
  verifiedAt       DateTime?
  verifiedById     Int?
  createdAt        DateTime                @default(now())

  payment    Payment                      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tenant     Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  verifiedBy User?                        @relation("PaymentSubmissionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  auditTrail PaymentVerificationHistory[]

  @@index([paymentId, createdAt])
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

model PaymentVerificationHistory {
  id                  Int                     @id @default(autoincrement())
  paymentSubmissionId Int
  status              PaymentSubmissionStatus
  remarks             String?
  changedById         Int?
  createdAt           DateTime                @default(now())

  paymentSubmission PaymentSubmission @relation(fields: [paymentSubmissionId], references: [id], onDelete: Cascade)
  changedBy         User?             @relation("PaymentVerificationActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([paymentSubmissionId, createdAt])
}

model MaintenanceRequest {
  id                      Int               @id @default(autoincrement())
  tenantId                Int
  roomId                  Int
  title                   String
  description             String
  priority                Priority          @default(MEDIUM)
  status                  MaintenanceStatus @default(PENDING)
  isPublic                Boolean           @default(false)
  assignedStaffId         Int?
  announcementTitle       String?
  announcementDescription String?
  publicLocation          String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  room   Room   @relation(fields: [roomId], references: [id])

  assignedStaff User?                      @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  statusHistory MaintenanceStatusHistory[]

  @@index([tenantId])
  @@index([roomId])
  @@index([status, updatedAt])
}

model MaintenanceStatusHistory {
  id                   Int               @id @default(autoincrement())
  maintenanceRequestId Int
  status               MaintenanceStatus
  note                 String?
  changedById          Int?
  createdAt            DateTime          @default(now())

  maintenanceRequest MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)
  changedBy          User?              @relation("MaintenanceStatusActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([maintenanceRequestId, createdAt])
}

model NotificationLog {
  id               Int      @id @default(autoincrement())
  recipientEmail   String
  notificationType String
  subject          String
  resendMessageId  String?
  status           String
  errorMessage     String?
  createdAt        DateTime @default(now())
}

model RoomInvitation {
  id        Int              @id @default(autoincrement())
  roomId    Int
  tenantId  Int?
  code      String           @unique
  status    InvitationStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  expiresAt DateTime

  room   Room    @relation(fields: [roomId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([roomId])
}
